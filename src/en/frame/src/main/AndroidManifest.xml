<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Marcador usado por Nekoyomi/Aniyomi para distinguir extensiones de apps normales. -->
    <uses-feature android:name="tachiyomi.animeextension" />

    <application
        android:label="Frame"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true">
        <meta-data
            android:name="tachiyomi.animeextension"
            android:value="true" />
        <meta-data
            android:name="tachiyomi.animeextension.class"
            android:value="eu.kanade.tachiyomi.animeextension.en.frame.Frame" />
        <meta-data
            android:name="tachiyomi.animeextension.hasSettings"
            android:value="true" />
        <meta-data
            android:name="tachiyomi.animeextension.nsfw"
            android:value="0" />
    </application>
</manifest>
